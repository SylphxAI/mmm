{
  "name": "mconv",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target browser && bun run build:types",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "test": "bun test",
    "bench": "bun run ./bench/index.ts",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@sylphx/codec-core": "workspace:*",
    "@sylphx/codec": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@biomejs/biome": "^2.3.12",
    "@sylphx/biome-config": "^0.4.1"
  }
}
